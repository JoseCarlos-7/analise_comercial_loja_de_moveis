	measure margem_de_contribuicao = [receita] - [cmv]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: KPI
		lineageTag: 51a39e61-b6ca-4c11-aa96-be376ffd0bf3

