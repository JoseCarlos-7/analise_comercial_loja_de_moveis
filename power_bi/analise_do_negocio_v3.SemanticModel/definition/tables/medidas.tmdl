	measure 'Cor margem de geração de caixa' =
			
			var limite = 0.15
			RETURN SWITCH(
			    TRUE(),
			    [margem de geracao de caixa] >= limite*2, "#07E821",
			    [margem de geracao de caixa] >= limite, "#FFEA7F",
			    [margem de geracao de caixa] < limite, "#ED1717",
			    [margem de geracao de caixa] = 0, "#FFFFFF",
			    "#055913"
			)
		displayFolder: controle_de_visuais
		lineageTag: 4230fa01-e3c4-4414-839a-c8beea4399d2

	measure 'Indicador Selecionado' = ```
			
			
			VAR indicador =
			    SELECTEDVALUE(Indicadores[KPI])
			
			RETURN
			
			SWITCH(
			    indicador,
			
			    
			    "margem de geracao de caixa", [margem de geracao de caixa],
			
			    0
			)
			```
		formatString: 0
		displayFolder: controle_de_visuais
		lineageTag: 9c8e93bd-2ccf-4a4f-bb2b-40034050174f

	measure 'estoque medio valor' = ```
			
			var estoque_inicial = 
			CALCULATE(SUMX(fato_estoque_mensal,fato_estoque_mensal[valor_estoque]),DATEADD(dim_calendario[Início do Mês],-1,MONTH))
			var estoque_final = 
			CALCULATE(SUMX(fato_estoque_mensal,fato_estoque_mensal[valor_estoque]))
			var estoque_medio = (estoque_inicial + estoque_final)/2
			RETURN estoque_medio
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: estoque
		lineageTag: f2cfcf65-0d41-45aa-a075-f9ff47705bb5

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'giro de estoque valor' = ROUNDUP(CALCULATE(DIVIDE([cmv],[estoque medio valor]),ALLEXCEPT(dim_calendario,dim_calendario[Ano])),2)
		displayFolder: estoque
		lineageTag: 4c3f438d-7515-4dd2-b307-95ac8cd13b91

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure rank_mes =
			
			RANKX(
			    ALLSELECTED(dim_calendario[Início do Mês]),
			    STARTOFMONTH(dim_calendario[Início do Mês]),
			    ,
			    ASC,
