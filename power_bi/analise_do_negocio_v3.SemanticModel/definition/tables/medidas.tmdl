	measure '% Acumulado (idc pressao cmv)' = ```
			
			VAR TotalGeral = 
			    CALCULATE(
			        [pressão × CMV],
			        ALLSELECTED(dim_produtos[produto])
			    )
			RETURN
			    DIVIDE([idc pressao cmv acumulada], TotalGeral)
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: pareto
		lineageTag: 80be5ede-aa74-401d-a0f7-d9a0010ee2e3

	measure 'rank idc produto' =
			
			RANKX(
			    // CALCULATETABLE(ALLSELECTED(dim_produtos[produto]),ALLEXCEPT(dim_calendario,dim_calendario[Ano])),
			    ALLSELECTED(dim_produtos[produto]),
			    [pressão × CMV],
			    ,
			    DESC,
			    Dense
			)
		formatString: 0
		displayFolder: pareto
		lineageTag: 2c7e52b2-bfde-45dc-b52d-cca51fd96f25

	measure 'idc pressao cmv acumulada' =
			
			VAR RankAtual = [rank idc produto]
			RETURN
			    SUMX(
			        FILTER(
			            ALLSELECTED(dim_produtos[produto]),
			            [rank idc produto] <= RankAtual
			        ),
			        [pressão × CMV]
			    )
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		displayFolder: pareto
		lineageTag: c046d7a2-86ce-4b17-9f2c-f035ee2e5d0e

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'pressão × CMV visual' =
			
			var idc_cmv_tt = CALCULATE([idc de pressao de estoque] * [cmv],ALLSELECTED(dim_produtos[produto]))
			RETURN DIVIDE(([idc de pressao de estoque] * [cmv]),idc_cmv_tt)
		formatString: 0.00%;-0.00%;0.00%
