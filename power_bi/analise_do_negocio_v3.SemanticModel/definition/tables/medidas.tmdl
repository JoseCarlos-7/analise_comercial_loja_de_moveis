	measure 'evolucao trimestral cmv' =
			
			var trimestre_anterior =
			CALCULATE(
			    [CMV],
			    PREVIOUSQUARTER(dim_calendario[data])
			)
			RETURN DIVIDE(
			    [CMV] - trimestre_anterior,
			    trimestre_anterior
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: comparacao
		lineageTag: f882da30-174e-4574-b43f-94b8326ec697

	measure 'evolucao anual cmv' =
			
			var ano_anterior =
			CALCULATE(
			    [CMV],
			    SAMEPERIODLASTYEAR(dim_calendario[data])
			)
			RETURN DIVIDE(
			    [CMV] - ano_anterior,
			    ano_anterior
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: comparacao
		lineageTag: f838b4d6-5e4c-4ffa-9701-d37c5efee02d

