	measure 'estoque medio valor anual' = ```
			
			var meses = CALCULATE(DISTINCTCOUNT(fato_estoque_mensal[data_snapshot]),ALLEXCEPT(dim_calendario,dim_calendario[Ano]))
			var em = CALCULATE(SUM(fato_estoque_mensal[valor_estoque]),ALLEXCEPT(dim_calendario,dim_calendario[Ano])) 
			RETURN DIVIDE(em,meses)
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: estoque
		lineageTag: f5a2db58-d38d-4d96-ac9e-f811e5f332ef

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'cmv anual' = ```
			
			var meses = CALCULATE(DISTINCTCOUNT(fato_estoque_mensal[data_snapshot]),ALLEXCEPT(dim_calendario,dim_calendario[Ano]))
			
			var cmv = CALCULATE(SUMX(fato_vendas,fato_vendas[quantidade]*(fato_vendas[custo_mercadoria]/fato_vendas[quantidade])),ALLEXCEPT(dim_calendario,dim_calendario[Ano])) 
			
			RETURN DIVIDE(cmv,meses)
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: custo
		lineageTag: 7ff3a652-9532-4cdb-9e09-03a4713d5d3b

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'giro de estoque valor anual' = ROUNDUP(CALCULATE(DIVIDE([cmv anual],[estoque medio valor anual]),ALLEXCEPT(dim_calendario,dim_calendario[Ano])),2)
		displayFolder: estoque
		lineageTag: 282108ec-97c6-458b-9a1d-1c0eb71ce872

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cor quadrante giro e estoque medio' = ```
			
			var ema = [estoque medio valor anual]
			var giro = [giro de estoque valor anual]
			RETURN SWITCH(
			    TRUE(),
			    and([estoque medio valor] <= ema, [giro de estoque valor] > giro), "#FFFFFF",
			    and([estoque medio valor] <= ema, [giro de estoque valor] <= giro), "#E6E6E6",
			    and([estoque medio valor] > ema, [giro de estoque valor] > giro), "#FFEA7F",
			    and([estoque medio valor] > ema, [giro de estoque valor] <= giro), "#FF9900",
			    
			    "#055913"
			)
			```
		displayFolder: controle_de_visuais
		lineageTag: 815fdcb9-67f1-47a0-8af9-a388600a7bfc

	measure 'idc de pressao de estoque' = ```
			
			var ema = [estoque medio valor anual]
			var giro = [giro de estoque valor anual]
			RETURN CALCULATE(DIVIDE(DIVIDE([estoque medio valor],ema),DIVIDE([giro de estoque valor anual],giro)),ALLEXCEPT(dim_calendario,dim_calendario[Ano]))
			
			```
		displayFolder: KPI
		lineageTag: c598c66d-5b15-48bc-8653-b404dfd7cd76

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'pressão × CMV' = ```
			
