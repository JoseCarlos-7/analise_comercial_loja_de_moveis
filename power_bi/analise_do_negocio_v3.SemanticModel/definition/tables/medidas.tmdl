	measure 'dias de caixa' =
			
			VAR cmv = SUMX(fato_vendas,fato_vendas[custo_mercadoria])
			VAR caixa = SUM(fato_fluxo_caixa[fluxo_liquido])
			VAR dias_caixa = DIVIDE(caixa,(cmv/30))
			RETURN dias_caixa
		displayFolder: fluxo_de_caixa
		lineageTag: 5115149c-2a4f-462a-abae-a40381d01e91

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cor dias_de_caixa' =
			
			var limite = 20
			RETURN SWITCH(
			    TRUE(),
			    [dias de caixa] >= (limite*1.5), "#07E821",
			    [dias de caixa] >= limite, "#FFEA7F",
			    [dias de caixa] < limite, "#FF9900",
			    [dias de caixa] <= 0, "#ED1717",
			
			    "#055913"
			)
		displayFolder: controle_de_visuais
		lineageTag: 6da317a6-13d4-4e6a-a449-ceea1056f56a

	measure 'margem evolucao aa %' =
			
			var margem_aa = CALCULATE([margem_de_contribuicao],SAMEPERIODLASTYEAR(dim_calendario[Início do Mês]),ALL())
			RETURN DIVIDE(([margem_de_contribuicao]-margem_aa),margem_aa)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: KPI
		lineageTag: 9a0c72f4-bdaf-43a8-991e-c1a1c9d041c6

	measure 'caixa evolucao %' =
			
			var caixa_aa = CALCULATE([caixa],SAMEPERIODLASTYEAR(dim_calendario[Início do Mês]),ALL())
			RETURN DIVIDE(([caixa]-caixa_aa),caixa_aa)
		formatString: 0.00%;-0.00%;0.00%
