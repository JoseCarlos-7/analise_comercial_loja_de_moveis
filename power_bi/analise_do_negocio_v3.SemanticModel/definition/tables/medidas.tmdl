	measure 'Cor margem de contribuicao' =
			
			var limite = 0.10
			RETURN SWITCH(
			    TRUE(),
			    [margem pct] >= limite*6, "#07E821",
			    [margem pct] >= limite*4, "#FFFFFF",
			    [margem pct] >= limite*2, "#CCCCCC",
			    [margem pct] < limite, "#ED1717",
			    [margem pct] <= 0, "#ED1717",
			    "#055913"
			)
		displayFolder: controle_de_visuais
		lineageTag: 4b860595-b440-4052-a14c-bfab4a3f8784

