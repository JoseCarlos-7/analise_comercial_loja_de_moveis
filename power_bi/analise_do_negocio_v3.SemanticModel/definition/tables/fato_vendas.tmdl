		dataType: string
		lineageTag: ec8497ab-536c-4df6-9daf-8c8856664f49
		summarizeBy: none
		sourceColumn: linha

		annotation SummarizationSetBy = Automatic

	column categoria
		dataType: string
		lineageTag: d6ddf4fc-d3d9-4d3a-941d-992a9ae65b5a
		summarizeBy: none
		sourceColumn: categoria

		annotation SummarizationSetBy = Automatic

